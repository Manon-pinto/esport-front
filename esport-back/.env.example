# Copier ce fichier en .env puis remplacer les valeurs (le .env n'est jamais commité)

# Connexion MongoDB : locale (docker compose up -d mongodb) ou chaîne Atlas en production
MONGODB_URI=mongodb://localhost:27017/esport

# Authentification JWT
JWT_SECRET=un_secret_long_et_aleatoire
JWT_EXPIRES_IN=24h

# Coût du hachage bcrypt (10 par défaut)
BCRYPT_ROUNDS=10

# Port de l'API en local (ignoré sur Vercel)
PORT=3000

# Origines autorisées par CORS, séparées par des virgules
FRONTEND_URL=http://localhost:3001
